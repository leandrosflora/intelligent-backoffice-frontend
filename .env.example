# Usado pelo container Nginx para encaminhar /api ao backend .NET.
# O default 5260 corresponde ao `dotnet run` (launchSettings.json) do backend rodando fora
# do Docker. Se o backend também estiver em Docker via `docker compose --profile runtime`
# (porta publicada 8080 por padrão), use BACKEND_URL=http://host.docker.internal:8080.
BACKEND_URL=http://host.docker.internal:5260

# Porta publicada pelo container do frontend no host (padrão 3000). Ajuste se 3000 já
# estiver em uso/reservada na máquina.
# FRONTEND_PORT=3000

# Usado pelo Vite durante desenvolvimento local.
VITE_API_PROXY_TARGET=http://localhost:5260

# Opcional: substitui o prefixo /api por uma URL acessível pelo navegador.
# VITE_API_BASE_URL=https://backoffice-api.example.com
